# Copy to configs/local.yaml (gitignored) and fill in local paths.
# No usernames or cluster names belong in committed files.

repo_root: /path/to/TextCancEHR2
results_root: /path/to/experiments/Results
labels_cache_root: /path/to/experiments/labels_cache

mimic:
  data_dir: /path/to/MIMIC-IV_tokenisation
  vocab_filepath: /path/to/MIMIC-IV_tokenisation/vocab.csv
  lookup_dir: /path/to/MIMIC_data/hosp
  labels_root: /path/to/MIMIC_data/labels
  meds_dir: /path/to/clean_meds
  checkpoints:
    mistral: /path/to/tehr_stage1_mimic_mistral/final_model
    qwen0.6: /path/to/tehr_stage1_mimic_qwen0.6/final_model
    qwen8: /path/to/tehr_stage1_mimic_qwen8/final_model
  encoder_mlm_checkpoint: /path/to/mimic-encoder/models/pretrained_encoder_stage1_mlm.pt
  decoder_ntp_checkpoint: /path/to/mimic-decoder/models/pretrained_decoder_stage1_ntp.pt
  text_embedding_path: /path/to/mimic-text_embedding/phrase_embeddings.pt

ehrshot:
  data_dir: /path/to/EHRSHOT_tokenisation
  vocab_filepath: /path/to/EHRSHOT_tokenisation/vocab.csv
  concept_csv: /path/to/EHRSHOT_ASSETS/femr/logs/omop_dir/concept.csv
  labels_root: /path/to/EHRSHOT_data/labels
  events_csv: /path/to/EHRSHOT_ASSETS/data/ehrshot.csv
  splits_csv: /path/to/EHRSHOT_ASSETS/splits/person_id_map.csv
  checkpoints:
    mistral: /path/to/tehr_stage1_ehrshot_mistral/final_model
    qwen0.6: /path/to/tehr_stage1_ehrshot_qwen0.6/final_model
    qwen8: /path/to/tehr_stage1_ehrshot_qwen8/final_model
  encoder_mlm_checkpoint: /path/to/ehrshot-encoder/models/pretrained_encoder_stage1_mlm.pt
  decoder_ntp_checkpoint: /path/to/ehrshot-decoder/models/pretrained_decoder_stage1_ntp.pt
  text_embedding_path: /path/to/ehrshot-text_embedding/phrase_embeddings.pt

clmbr:
  model_dir: /path/to/clmbr_t_base
  maps_dir: /path/to/clmbr_maps

cprd:
  data_dir: /path/to/cprd_tokenisation
  vocab_filepath: /path/to/cprd_tokenisation/vocab.csv
  labels_filepath: /path/to/subject_information.csv
  medical_lookup_filepath: src/resources/MedicalDictTranslation2.csv
  lab_lookup_filepath: src/resources/LabLookUP.csv
  region_lookup_filepath: src/resources/RegionLookUp.csv
  time_lookup_filepath: src/resources/TimeLookUp.csv
  checkpoints:
    mistral: /path/to/tehr_stage1_cprd_mistral/final_model
    qwen0.6: /path/to/tehr_stage1_cprd_qwen0.6/final_model
    qwen8: /path/to/tehr_stage1_cprd_qwen8/final_model
  encoder_mlm_checkpoint: /path/to/cprd-encoder/models/pretrained_encoder_stage1_mlm.pt
  decoder_ntp_checkpoint: /path/to/cprd-decoder/models/pretrained_decoder_stage1_ntp.pt
  text_embedding_path: /path/to/cprd-text_embedding/phrase_embeddings.pt

# Optional trainer overlay (VRAM). Example:
training:
  eval_batch_size: 1
