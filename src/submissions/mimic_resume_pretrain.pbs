#!/bin/bash
#PBS -l select=1:ncpus=8:mem=256gb:ngpus=2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /rds/general/user/ag619/home/ashvin/TextCancEHR2/logs/

ml tools/prod
ml SciPy-bundle/2025.07-gfbf-2025.07
source ~/venv/TextEHR2_env/bin/activate

cd $PBS_O_WORKDIR

export WANDB_API_KEY="REDACTED"

echo "Starting experiment from directory: $(pwd)"
export PYTHONPATH="${BASE_DIR}:${PYTHONPATH}"


torchrun --nproc_per_node=2 src/pipelines/resume_pretrain.py \
  --config_filepath src/configs/resume_pretrain_config.yaml \
  --checkpoint_path /rds/general/user/ag619/ephemeral/MIMIC/experiments/Pretrain-Mistral-7B-Pretrain/checkpoint-9000
echo "Resume pretraining finished."
deactivate

