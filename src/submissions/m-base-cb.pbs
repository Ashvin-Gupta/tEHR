#!/bin/bash
#PBS -l select=1:ncpus=4:mem=128gb
#PBS -l walltime=1:00:00
#PBS -j oe
#PBS -o /rds/general/user/ag619/home/ashvin/TextCancEHR2/logs/

ml tools/prod
ml SciPy-bundle/2025.07-gfbf-2025.07
source ~/venv/TextEHR2_env/bin/activate

cd $PBS_O_WORKDIR

export WANDB_API_KEY="REDACTED"

echo "Starting experiment from directory: $(pwd)"
export PYTHONPATH="${BASE_DIR}:${PYTHONPATH}"

python -m src.pipelines.run_baseline_clinicalbert --config_filepath src/configs/baseline_clinicalbert_config.yaml 

echo "Pipeline finished."
deactivate